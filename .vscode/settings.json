{
  // Από το template του Ionic: να μη προτείνει imports από αρχεία του Ionic που δεν χρησιμοποιούμε.
  "typescript.preferences.autoImportFileExcludePatterns": [
    "@ionic/angular/types/ionic-angular-lazy.d.ts",
    "@ionic/angular/types/ionic-angular-common.d.ts"
  ],

  // ── Όπως στο lucky-sevens: για να ΔΙΑΒΑΖΕΙΣ τον κώδικα εύκολα ──
  // Πάνω-πάνω μένει κολλημένη η κλάση/συνάρτηση όπου βρίσκεσαι
  "editor.stickyScroll.enabled": true,
  // Τα βελάκια για να ανοίγεις/κλείνεις κλάσεις και συναρτήσεις φαίνονται ΠΑΝΤΑ (όχι μόνο στο hover)
  "editor.showFoldingControls": "always",
  // Γκρι «υποδείξεις» μέσα στον κώδικα: ονόματα παραμέτρων και τύποι που βγάζει μόνο του το TypeScript
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  // Το μονοπάτι πάνω από τον κώδικα (κλικ = πας σε άλλη συνάρτηση του ίδιου αρχείου)
  "breadcrumbs.enabled": true,
  // Ίδια ζεύγη παρενθέσεων με ίδιο χρώμα + γραμμή που δείχνει πού ανοίγει/κλείνει το μπλοκ όπου είσαι
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",

  // ── Τεστ (Vitest) ──
  // Το plugin «Vitest» (εικονίδιο με τον δοκιμαστικό σωλήνα): ▶ δίπλα σε κάθε τεστ του πυρήνα.
  // Διαβάζει ΜΟΝΟ αυτό το αρχείο ρυθμίσεων· το «npm test» συνεχίζει να τρέχει όλα τα τεστ μέσω Angular.
  "vitest.rootConfig": "vitest.core.config.mts",

  // ── Νέα αρχεία ──
  // Το src είναι junction προς το OneDrive, και από εκεί δεν φτάνουν ειδοποιήσεις για νέα αρχεία.
  // Έτσι ο TypeScript ξανακοιτάζει μόνος του τους φακέλους και δεν χρειάζεται «Restart TS Server».
  "typescript.tsserver.watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriorityPolling"
  },

  // ── Αποθήκευση ──
  // Αποθηκεύει όταν φεύγεις από το αρχείο (όχι κάθε 1″), για να μην ξανατρέχουν τα τεστ σε μισογραμμένο κώδικα
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": false,

  // ── Μορφοποίηση (Shift+Alt+F) ──
  // Ο Prettier σπάει μόνος του τις μεγάλες γραμμές σε πολλές, όπως θα τις έσπαγες με το χέρι.
  // Πάνω από 100 χαρακτήρες: ένα πεδίο του αντικειμένου ή ένα όρισμα ανά γραμμή. Μονά εισαγωγικά, όπως ήδη γράφεις.
  // (Ο ενσωματωμένος formatter του TypeScript δεν σπάει ποτέ γραμμές· γι' αυτό «κρατούσε» τη μεγάλη γραμμή.)
  // ΠΡΟΣΟΧΗ: επειδή υπάρχει .editorconfig, ο Prettier παίρνει το όριο από εκεί (max_line_length = 100), όχι από τις δύο γραμμές πιο κάτω.
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "prettier.printWidth": 100,
  "prettier.singleQuote": true,
  "files.exclude": { "**/.angular": true, "www": true }
}
